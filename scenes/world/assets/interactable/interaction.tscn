[gd_scene format=3 uid="uid://l0a5nwr6k3xn"]

[sub_resource type="GDScript" id="GDScript_nucce"]
resource_name = "interaction"
script/source = "extends Node


# Como o label está dentro de UI, usamos o caminho completo ou o % se for nome único
@onready var label: Label = %InteractionLabel

func set_text(text: String) -> void:
	label.text = text

func alternar_visibilidade(is_visible: bool) -> void:
	label.visible = is_visible

func update_item_icon(item_data: Node) -> void:
	# 1. Get the name of the object node itself
	var node_name: String = item_data.name 
	
	# 2. Extract properties from your custom ItemData fields
	var custom_name: String = item_data.item_name
	var custom_icon: Texture2D = item_data.item_icon # Godot 4 texture type
	
	# 3. Assign the pre-loaded icon directly (Most efficient)
	if custom_icon != null:
		$TextureRect.texture = custom_icon
	else:
		# Fallback: try loading via string if the resource reference is missing
		var path = \"res://assets/icons/\" + custom_name + \".png\"
		if ResourceLoader.exists(path):
			$TextureRect.texture = load(path)
"

